# Copy to .env and fill in. .env is gitignored and must never be committed.
# Everything runs without any of these — the offline provider needs no key and no network.

# --- model access (optional) ---------------------------------------------------------------
# Either paste the key directly...
# EARSHOT_OPENROUTER_API_KEY=sk-or-v1-...
#
# ...or point at a file containing it, which keeps the key out of your shell history and
# out of any process listing.
# EARSHOT_OPENROUTER_API_KEY_FILE=C:/tmp/openrouterAPIKey.txt

# Override the model. Anything OpenRouter serves works; the default is pinned so published
# cost and latency figures stay meaningful.
# EARSHOT_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- response cache ------------------------------------------------------------------------
# record  — call the model and save the response to artifacts/cache/ (default)
# replay  — serve from the cache, never touch the network. This is how the demo survives a
#           room with no wifi; it works with no key set at all.
# off     — always call the model
# EARSHOT_CACHE_MODE=replay

# The model reader (`--extractor model`) records into its own file, so extraction traffic never
# lands in the investigator cache the demo replays from. Defaults to artifacts/cache/extractor.jsonl
# EARSHOT_EXTRACTOR_CACHE_PATH=artifacts/cache/extractor.jsonl

# --- output --------------------------------------------------------------------------------
# Where run manifests and eval results are written. Defaults to ./artifacts
# EARSHOT_ARTIFACTS=artifacts
