{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(docs/sources/**)",
      "Write(docs/sources/**)"
    ],
    "ask": [
      "Edit(docs/ops/decisions.md)",
      "Edit(docs/ops/working-agreements.md)",
      "Edit(CLAUDE.md)",
      "Edit(docs/architecture/**)",
      "Edit(benchmarks/*/PROTOCOL.md)",
      "Edit(benchmarks/*/MARKING-GUIDE.md)",
      "Edit(artifacts/cache/**)",
      "Edit(artifacts/runs/pinned/**)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ],
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run earshot:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(npx cdk diff:*)",
      "Bash(npx cdk synth:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws s3api get-object-lock-configuration:*)",
      "Bash(aws bedrock list-foundation-models:*)"
    ]
  }
}
