# AWS config template — copy to ~/.aws/config (NOT into this repo).
#
#   Windows:  %USERPROFILE%\.aws\config
#
# Nothing secret belongs in this file. It names *where* to get credentials, never the
# credentials themselves — which is the whole point: there is no secret to leak and
# nothing to recreate when a token expires.
#
# Fill the two <PLACEHOLDER> values before use. See docs/ops/aws-credentials.md.

[sso-session zenon]
# Ours is https://identitycenter.amazonaws.com/ssoins-7223528ddbceb375 and it WORKS — verified
# on aws-cli/2.36.29. The canonical portal forms (https://d-xxxxxxxxxx.awsapps.com/start,
# https://ssoins-....portal.<region>.app.aws) also work; the CLI requires an https scheme and a
# resolvable OIDC endpoint, not a particular hostname. To check any candidate without a browser:
#   aws sso login --profile genesis --no-browser
sso_start_url = <SSO_START_URL>
# The region the Identity Center INSTANCE lives in — independent of the build region below.
sso_region = us-east-1
sso_registration_scopes = sso:account:access

[profile genesis]
sso_session = zenon
sso_account_id = 859430413223
sso_role_name = agentic-trio
# The BUILD region — where Bedrock and every resource live. Deliberately us-east-1 and NOT
# ap-southeast-2, even though the console opens on Sydney: Appendix B's prices, the model ARNs
# and the `us.` inference profiles in infrastructure.md §A.1 are all us-east-1. Switching the
# console region picker is cosmetic; this line is what the CLI and boto3 actually use.
region = us-east-1
output = json
